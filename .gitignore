# Unity 官方模板 .gitignore（Unity 6 / 6000.x）基础上按本项目补充
# 参考：https://github.com/github/gitignore/blob/main/Unity.gitignore

# ==== Unity 生成目录（不入库）====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 资产的 .meta 必须入库（仅当对应资产被忽略时才忽略 meta）
!/[Aa]ssets/**/*.meta

# 崩溃报告 / 构建产物
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# ==== IDE / 生成工程文件 ====
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.sln.DotSettings.user

# Unity 生成的 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables 打包产物
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Android 临时资源
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ==== 系统垃圾文件 ====
.DS_Store
Thumbs.db
desktop.ini

# ==== Steam ====
# steam_appid.txt（值 480）是运行必需文件，必须入库，因此不在此忽略。
